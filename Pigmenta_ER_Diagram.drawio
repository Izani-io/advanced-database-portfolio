        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    CATEGORIES ||--o{ PRODUCTS : classifies\n    SUPPLIERS ||--o{ PRODUCTS : supplies\n    CUSTOMERS ||--o{ ORDERS : places\n    ORDERS ||--o{ ORDER_ITEMS : contains\n    PRODUCTS ||--o{ ORDER_ITEMS : included_in\n\n    CATEGORIES {\n        int category_id PK\n        varchar category_name\n        text description\n    }\n\n    SUPPLIERS {\n        int supplier_id PK\n        varchar supplier_name\n        varchar contact_person\n        varchar email\n        varchar phone\n        text address\n    }\n\n    PRODUCTS {\n        int product_id PK\n        varchar product_name\n        varchar sku\n        int category_id FK\n        int supplier_id FK\n        numeric unit_price\n        int stock_quantity\n        int reorder_level\n    }\n\n    CUSTOMERS {\n        int customer_id PK\n        varchar customer_name\n        varchar email\n        varchar phone\n        text address\n    }\n\n    ORDERS {\n        int order_id PK\n        int customer_id FK\n        timestamp order_date\n        varchar order_status\n        numeric total_amount\n    }\n\n    ORDER_ITEMS {\n        int order_item_id PK\n        int order_id FK\n        int product_id FK\n        int quantity\n        numeric unit_price\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="x-P__Cps2251ggH5OR3F-1">
